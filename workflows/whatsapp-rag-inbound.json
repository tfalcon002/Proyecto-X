                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "availability",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "availability"
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      }
