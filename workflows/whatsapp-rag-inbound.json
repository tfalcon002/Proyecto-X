    {
      "id": "34",
      "name": "Log Interaction",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3920, 260],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RAG_API_URL }}/interactions",
        "authentication": "none",
        "sendHeaders": true,
