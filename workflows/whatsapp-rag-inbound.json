        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { client_id: $env.FALCON_CLIENT_ID, channel: 'whatsapp', from_number: $json.to, intent: $('Create Handoff').isExecuted ? 'handoff' : $('Detect Intent').first().json.intent, user_message: $('Detect Intent').first().json.text, agent_response: $json.text.body, wa_message_id: $('Extract Message').first().json.waMessageId } }}",
        "options": { "response": { "response": { "neverError": true } } },
        "continueOnFail": true
      }
    },
    {
