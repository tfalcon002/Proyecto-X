    {
      "id": "19",
      "name": "Detect Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1520, 100],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const raw = ($json.text || '').trim();\nconst text = raw.toLowerCase();\n\n// MVP por palabras clave. Para mayor precisión, reemplazar por una\n// clasificación vía LLM (ver \"Pendiente\" en workflows/README.md).\nconst handoffKeywords = ['hablar con', 'una persona', 'humano', 'ejecutivo', 'asesor', 'vendedor', 'quiero comprar', 'hacer un pedido', 'quiero encargar', 'cotizar', 'cotización', 'cotizacion'];\nconst bookingKeywords = ['confirmar', 'confirmo', 'reservar', 'agendar el', 'book', 'agendo'];\nconst availabilityKeywords = ['disponibilidad', 'horarios', 'horario', 'agendar', 'agenda', 'cita', 'citas', 'appointment', 'schedule', 'availability', 'reunión', 'reunion', 'llamada', 'call'];\n// Negocios que no agendan (p. ej. venta de productos) apagan Cal.com con\n// AGENDA_ENABLED=false: esas preguntas pasan al RAG.\nconst agendaEnabled = String($env.AGENDA_ENABLED || 'true').toLowerCase() !== 'false';\n\nconst hasDateTime = /\\d{4}-\\d{2}-\\d{2}[t ]\\d{2}:\\d{2}/i.test(text);\nconst hasEmail = /[^\\s@]+@[^\\s@]+\\.[^\\s@]+/.test(text);\n\nlet intent = 'rag';\nif (handoffKeywords.some((k) => text.includes(k))) {\n  intent = 'handoff';\n} else if (agendaEnabled && (bookingKeywords.some((k) => text.includes(k)) || (hasDateTime && hasEmail))) {\n  intent = 'booking';\n} else if (agendaEnabled && availabilityKeywords.some((k) => text.includes(k))) {\n  intent = 'availability';\n}\n\nreturn [{ json: { ...$json, intent } }];\n"
      }
    },
    {
      "id": "20",
      "name": "Route by Intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [2480, 100],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
