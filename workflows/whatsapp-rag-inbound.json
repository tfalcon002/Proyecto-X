    {
      "id": "13",
      "name": "Use Text As-Is",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [560, 240],
      "parameters": {
        "assignments": {
          "assignments": [
            { "name": "text", "type": "string", "value": "={{ $json.text }}" }
          ]
        },
        "options": {}
      }
