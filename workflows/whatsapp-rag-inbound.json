        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { name: $env.NOVU_WORKFLOW_ID, to: { subscriberId: $('Extract Message').first().json.from, email: $('Extract Booking Details').first().json.attendeeEmail }, payload: { startTime: $('Extract Booking Details').first().json.startTime, attendeeName: $('Extract Booking Details').first().json.attendeeName, bookingStatus: $json.error ? 'failed' : 'confirmed' } } }}",
        "options": { "response": { "response": { "neverError": true } } },
        "continueOnFail": true
      }
    },
