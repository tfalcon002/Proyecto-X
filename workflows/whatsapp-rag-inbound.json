      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3440, -420],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const phone = $('Extract Message').first().json.from;\nconst body = $env.HANDOFF_REPLY || 'Le pasé tu mensaje a una persona del equipo y te va a contactar pronto por WhatsApp. ¡Gracias por la paciencia!';\n\nreturn [{\n  json: {\n    messaging_product: 'whatsapp',\n    to: phone,\n    type: 'text',\n    text: { body },\n  },\n}];\n"
      }
    },
    {
      "id": "43",
      "name": "Format Owner Notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3440, -620],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Aviso al dueño del negocio. Sin HANDOFF_NOTIFY_NUMBER no se avisa a nadie.\nconst to = String($env.HANDOFF_NOTIFY_NUMBER || '').replace(/\\D/g, '');\nif (!to) return [];\n\nconst message = $('Extract Message').first().json;\nconst askedForPerson = $('Detect Intent').first().json.intent === 'handoff';\nconst reason = askedForPerson\n  ? 'pidió hablar con una persona, comprar o cotizar'\n  : 'el bot no encontró la respuesta';\nconst summary = $json.summary || `Cliente: ${message.contactName || 'sin nombre'} (+${message.from})`;\nconst pauseNote = $json.paused_until ? ' El bot quedó en pausa con este cliente.' : '';\nconst text = `Cliente para atender: ${reason}.\\n${summary}\\nEscríbele: https://wa.me/${message.from}${pauseNote}`;\n\n// Fuera de la ventana de 24 h, WhatsApp solo deja enviar plantillas\n// aprobadas: con HANDOFF_TEMPLATE_NAME se usa la plantilla (un parámetro de\n// cuerpo, en una sola línea), si no, texto libre.\nif ($env.HANDOFF_TEMPLATE_NAME) {\n  return [{\n    json: {\n      messaging_product: 'whatsapp',\n      to,\n      type: 'template',\n      template: {\n        name: $env.HANDOFF_TEMPLATE_NAME,\n        language: { code: $env.HANDOFF_TEMPLATE_LANG || 'es' },\n        components: [{\n          type: 'body',\n          parameters: [{ type: 'text', text: text.replace(/\\s*\\n\\s*/g, ' | ').slice(0, 1000) }],\n        }],\n      },\n    },\n  }];\n}\n\nreturn [{ json: { messaging_product: 'whatsapp', to, type: 'text', text: { body: text } } }];\n"
      }
    },
    {
      "id": "44",
      "name": "Notify Owner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3680, -620],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $env.META_GRAPH_API_VERSION }}/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "authentication": "none",
