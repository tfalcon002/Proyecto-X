        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.RAG_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { client_id: $env.FALCON_CLIENT_ID, query: $json.text, session_id: $('Extract Message').first().json.from } }}",
        "options": {}
      }
    },
    {
      "id": "16",
      "name": "Format Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3200, -140],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const phone = $('Extract Message').first().json.from;\nconst answer = $json.answer || $json.response || 'Lo siento, no pude procesar tu mensaje en este momento.';\n\nreturn [{\n  json: {\n    messaging_product: 'whatsapp',\n    to: phone,\n    type: 'text',\n    text: { body: answer },\n  },\n}];\n"
      }
    },
    {
      "id": "21",
      "name": "Compute Availability Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2720, 100],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const now = new Date();\nconst end = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);\n\nreturn [{\n  json: {\n    ...$json,\n    availabilityStart: now.toISOString(),\n    availabilityEnd: end.toISOString(),\n  },\n}];\n"
      }
    },
    {
      "id": "22",
      "name": "Get Cal.com Availability",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3200, 100],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CALCOM_API_URL }}/slots",
        "authentication": "none",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "eventTypeId", "value": "={{ $env.CALCOM_EVENT_TYPE_ID }}" },
            { "name": "startTime", "value": "={{ $json.availabilityStart }}" },
            { "name": "endTime", "value": "={{ $json.availabilityEnd }}" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.CALCOM_API_KEY }}" },
            { "name": "cal-api-version", "value": "={{ $env.CALCOM_API_VERSION }}" }
          ]
        },
        "options": { "response": { "response": { "neverError": true } } }
      }
    },
    {
      "id": "23",
      "name": "Format Availability Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3440, 100],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const phone = $('Extract Message').first().json.from;\nconst data = $json.data || {};\nconst allSlots = Object.values(data).flat();\nconst times = allSlots.slice(0, 5).map((slot) => slot.time || slot.start).filter(Boolean);\n\nlet body;\nif (times.length === 0) {\n  body = 'No encontré horarios disponibles en los próximos días. Probá pedir otra fecha o escribinos más tarde.';\n} else {\n  const list = times.map((t) => `• ${t}`).join('\\n');\n  body = `Estos son los próximos horarios disponibles:\\n${list}\\n\\nPara confirmar, respondé con la fecha/hora elegida y tu email en un solo mensaje, por ejemplo:\\n2026-09-10T15:00 tu-email@ejemplo.com`;\n}\n\nreturn [{\n  json: {\n    messaging_product: 'whatsapp',\n    to: phone,\n    type: 'text',\n    text: { body },\n  },\n}];\n"
      }
    },
    {
      "id": "24",
      "name": "Extract Booking Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2720, 340],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const contactName = $('Extract Message').first().json.contactName || 'Cliente Falcon';\nconst text = $json.text || '';\n\nconst dateTimeMatch = text.match(/\\d{4}-\\d{2}-\\d{2}[t ]\\d{2}:\\d{2}(:\\d{2})?/i);\nconst emailMatch = text.match(/[^\\s@]+@[^\\s@]+\\.[^\\s@]+/);\n\nconst hasDetails = Boolean(dateTimeMatch && emailMatch);\n\nreturn [{\n  json: {\n    ...$json,\n    hasDetails,\n    startTime: dateTimeMatch ? dateTimeMatch[0].replace(' ', 'T') : null,\n    attendeeEmail: emailMatch ? emailMatch[0] : null,\n    attendeeName: contactName,\n  },\n}];\n"
      }
    },
    {
      "id": "25",
      "name": "Has Booking Details?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [3200, 340],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "leftValue": "={{ $json.hasDetails }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "26",
      "name": "Book Cal.com Appointment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3440, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CALCOM_API_URL }}/bookings",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.CALCOM_API_KEY }}" },
            { "name": "cal-api-version", "value": "={{ $env.CALCOM_API_VERSION }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { eventTypeId: Number($env.CALCOM_EVENT_TYPE_ID), start: $json.startTime, attendee: { name: $json.attendeeName, email: $json.attendeeEmail, timeZone: $env.CALCOM_TIMEZONE || 'America/Mexico_City' } } }}",
        "options": { "response": { "response": { "neverError": true } } }
      }
    },
    {
      "id": "27",
      "name": "Format Booking Confirmation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3680, 260],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const phone = $('Extract Message').first().json.from;\nconst startTime = $('Extract Booking Details').first().json.startTime;\nconst success = !$json.error && ($json.status === 'success' || $json.id || $json.uid);\n\nconst body = success\n  ? `¡Listo! Tu cita quedó agendada para ${startTime}. Te llegará la confirmación por email.`\n  : `No pude confirmar la cita (${$json.error?.message || 'horario no disponible'}). Probá con otro horario.`;\n\nreturn [{\n  json: {\n    messaging_product: 'whatsapp',\n    to: phone,\n    type: 'text',\n    text: { body },\n  },\n}];\n"
      }
    },
    {
      "id": "28",
      "name": "Format Missing Details Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3440, 460],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const phone = $('Extract Message').first().json.from;\nconst body = 'Para agendar necesito la fecha/hora y tu email en un solo mensaje, por ejemplo:\\n2026-09-10T15:00 tu-email@ejemplo.com';\n\nreturn [{\n  json: {\n    messaging_product: 'whatsapp',\n    to: phone,\n    type: 'text',\n    text: { body },\n  },\n}];\n"
      }
    },
    {
