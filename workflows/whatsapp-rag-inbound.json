    {
      "id": "36",
      "name": "Apply Handoff Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 100],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Si el RAG no responde, se asume que no hay pausa: mejor contestar de más que dejar\n// a un cliente sin respuesta.\nconst message = $('Detect Intent').first().json;\nreturn [{ json: { ...message, paused: $json.paused === true } }];\n"
      }
    },
