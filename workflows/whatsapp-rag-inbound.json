    {
      "id": "30",
      "name": "Compute Meta Signature",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [-400, 380],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "secret": "={{ $env.WHATSAPP_APP_SECRET }}",
        "binaryData": true,
        "binaryPropertyName": "data",
        "encoding": "hex",
