    {
      "id": "15",
      "name": "Query RAG (LlamaIndex)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2720, -140],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RAG_API_URL }}/query",
