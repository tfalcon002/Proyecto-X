        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.RAG_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { client_id: $env.FALCON_CLIENT_ID, from_number: $('Extract Message').first().json.from, reason: $('Detect Intent').first().json.intent === 'handoff' ? 'cliente_lo_pidio' : 'sin_respuesta', contact_name: $('Extract Message').first().json.contactName, last_message: $('Detect Intent').first().json.text } }}",
        "options": { "response": { "response": { "neverError": true } } }
