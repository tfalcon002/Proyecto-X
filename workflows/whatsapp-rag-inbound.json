        "url": "={{ $env.RAG_API_URL }}/handoffs/status?client_id={{ encodeURIComponent($env.FALCON_CLIENT_ID) }}&from_number={{ encodeURIComponent($('Extract Message').first().json.from) }}",
        "authentication": "none",
