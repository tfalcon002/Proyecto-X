    {
      "id": "31",
      "name": "Verify Meta Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-160, 380],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const webhookItem = $('Meta Events (POST)').first().json;\nconst headerSignature = webhookItem.headers?.['x-hub-signature-256'] || '';\nconst expected = `sha256=${$json.computedSignature}`;\n\n// Reconstruimos el body a partir del raw body verificado, en vez de\n// confiar en el parseo automático de n8n (así el JSON que llega a\n// \"Extract Message\" es exactamente el que Meta firmó).\nconst rawBodyBase64 = $input.first().binary?.data?.data;\nconst rawBodyString = rawBodyBase64 ? Buffer.from(rawBodyBase64, 'base64').toString('utf8') : '';\n\nlet parsedBody = webhookItem.body;\ntry {\n  if (rawBodyString) parsedBody = JSON.parse(rawBodyString);\n} catch (e) {\n  // si falla el parseo, seguimos con lo que n8n ya haya parseado\n}\n\nconst isValid = Boolean($env.WHATSAPP_APP_SECRET) && headerSignature === expected;\n\nreturn [{\n  json: {\n    headers: webhookItem.headers,\n    body: parsedBody,\n    signatureValid: isValid,\n  },\n}];\n"
      }
    },
    {
      "id": "32",
      "name": "Signature Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [80, 380],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "leftValue": "={{ $json.signatureValid }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "33",
