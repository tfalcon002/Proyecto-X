# Copiar a ".env" y completar antes de levantar docker-compose.
# Nunca commitear el archivo ".env" real (ver .gitignore).

# --- Postgres (base de datos de n8n) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=n8n

# --- n8n ---
# Clave usada por n8n para cifrar credenciales guardadas. Generarla una vez
# con: openssl rand -hex 32   y no volver a cambiarla (perderías las credenciales guardadas).
N8N_ENCRYPTION_KEY=cambiar-esta-clave-larga-aleatoria
N8N_PORT=5678
# En local dejar "localhost"; en el VPS usar el dominio real (ej: n8n.falcon.com)
N8N_HOST=localhost
N8N_PROTOCOL=http
# En local: http://localhost:5678/ ; en el VPS: https://n8n.falcon.com/
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Mexico_City
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambiar-esta-clave

# --- RAG service (LlamaIndex + pgvector) ---
# Base de datos separada dentro del mismo Postgres, con pgvector habilitado
# (la crea automáticamente postgres-init/init-rag-db.sh en el primer arranque).
RAG_DB=falcon_rag
RAG_PORT=8001
RAG_API_KEY=cambiar-esta-clave
# URL que usa n8n para llamar al servicio (nombre del servicio en docker-compose).
RAG_API_URL=http://rag:8000
# client_id de este tenant, ya registrado con POST /clients (ver rag-service/README.md).
# Esta instancia de n8n es de un solo cliente: todo /query y /interactions se manda con este valor.
FALCON_CLIENT_ID=cambiar-por-tu-client-id
# openai | ollama
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Debe coincidir con la dimensión del modelo de embeddings elegido:
# 1536 para text-embedding-3-small (OpenAI); ~768 para la mayoría de modelos de Ollama.
EMBEDDING_DIM=1536
# openai | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
# Solo si EMBEDDING_PROVIDER=ollama o LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=llama3.1
# Memoria: cuántos intercambios previos del mismo número recibe el modelo,
# y de cuántas horas atrás como máximo.
HISTORY_LIMIT=6
HISTORY_HOURS=24
# Horas que el bot se queda callado con un cliente después de derivarlo.
HANDOFF_PAUSE_HOURS=12

# --- Whisper (transcripción de audio de WhatsApp, ver workflows/) ---
WHISPER_API_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# --- WhatsApp / Meta Cloud API (ver workflows/) ---
WHATSAPP_VERIFY_TOKEN=cambiar-este-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v20.0
# App Secret de la app de Meta (App Dashboard → Configuración → Básica).
# NO es el mismo valor que WHATSAPP_ACCESS_TOKEN. Se usa para validar la
# firma X-Hub-Signature-256 que Meta manda en cada webhook — si queda
# vacío, el workflow rechaza todos los eventos entrantes (falla cerrado).
WHATSAPP_APP_SECRET=

# --- Derivación a una persona (ver workflows/README.md) ---
# WhatsApp del dueño que recibe el aviso, con código de país y sin "+"
# (ej. 56912345678). Vacío: se deriva y pausa igual, pero no se avisa a nadie.
HANDOFF_NOTIFY_NUMBER=
# Mensaje que recibe el cliente al ser derivado (vacío = texto por defecto).
HANDOFF_REPLY=
# Plantilla aprobada en Meta para avisar fuera de la ventana de 24 h, con un
# parámetro de cuerpo {{1}}. Vacío: se manda texto libre.
HANDOFF_TEMPLATE_NAME=
HANDOFF_TEMPLATE_LANG=es

# --- Cal.com (agendado de citas desde el chat, ver workflows/) ---
# "false" para negocios que no agendan: las preguntas de horarios/citas van al RAG.
AGENDA_ENABLED=true
CALCOM_API_URL=https://api.cal.com/v2
CALCOM_API_KEY=
# Versión de la API v2 exigida en el header "cal-api-version" (revisar
# https://cal.com/docs/api-reference/v2/versioning para la vigente).
CALCOM_API_VERSION=2024-08-13
# ID numérico del tipo de evento a agendar (Cal.com → Event Types → el que
# uses para las citas de Falcon → aparece en la URL del editor).
CALCOM_EVENT_TYPE_ID=
# Zona horaria usada al crear la reserva (debe ser un nombre IANA válido).
CALCOM_TIMEZONE=America/Mexico_City

# --- Novu (notificaciones multicanal al confirmar una cita, ver workflows/) ---
NOVU_API_URL=https://api.novu.co
NOVU_API_KEY=
# Identificador del "Workflow" configurado en el dashboard de Novu que
# define los canales (email/SMS/push/in-app) de la notificación de
# confirmación de cita.
NOVU_WORKFLOW_ID=
